{
  "name": "pratikar",
  "version": "1.0.0",
  "private": true,
  "description": "Privacy-first offline PWA for intimate-image abuse takedown and tamper-evident evidence logging under India IT Rules 2021",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-config.js && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate-config": "node scripts/validate-config.js",
    "check-i18n": "node scripts/check-i18n.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.js\" --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.js\""
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.1.1",
    "@fontsource-variable/noto-sans-devanagari": "5.1.1",
    "idb": "8.0.2",
    "lucide-react": "0.475.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.29.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.50.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.13.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.24.0",
    "@typescript-eslint/parser": "8.24.0",
    "@vitejs/plugin-react": "4.3.4",
    "ajv": "8.17.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.1.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "26.0.0",
    "postcss": "8.5.2",
    "prettier": "3.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "5.4.14",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
