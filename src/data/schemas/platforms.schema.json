{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlatformsConfig",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "displayName", "howToFindLink", "grievanceOfficerNote", "verified", "lastVerified"],
    "properties": {
      "id": { "type": "string" },
      "displayName": { "type": "string", "minLength": 1 },
      "howToFindLink": {
        "type": "object",
        "required": ["en", "hi", "mr"],
        "properties": {
          "en": { "type": "string", "minLength": 1 },
          "hi": { "type": "string", "minLength": 1 },
          "mr": { "type": "string", "minLength": 1 }
        }
      },
      "reportingPageUrl": { "type": ["string", "null"] },
      "grievanceOfficerNote": {
        "type": "object",
        "required": ["en", "hi", "mr"],
        "properties": {
          "en": { "type": "string", "minLength": 1 },
          "hi": { "type": "string", "minLength": 1 },
          "mr": { "type": "string", "minLength": 1 }
        }
      },
      "verified": { "type": "boolean" },
      "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "specialBadge": {
        "type": "object",
        "required": ["en", "hi", "mr"],
        "properties": {
          "en": { "type": "string", "minLength": 1 },
          "hi": { "type": "string", "minLength": 1 },
          "mr": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
