{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RulesConfig",
  "type": "object",
  "required": ["takedownHours", "statute", "ruleCitation", "legalReferences", "escalationLadder"],
  "properties": {
    "takedownHours": { "type": "integer", "enum": [24] },
    "statute": { "type": "string", "minLength": 1 },
    "ruleCitation": { "type": "string", "minLength": 1 },
    "legalReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "citation", "summary", "sourceUrl", "verified", "lastVerified"],
        "properties": {
          "id": { "type": "string" },
          "title": {
            "type": "object",
            "required": ["en", "hi", "mr"],
            "properties": {
              "en": { "type": "string", "minLength": 1 },
              "hi": { "type": "string", "minLength": 1 },
              "mr": { "type": "string", "minLength": 1 }
            }
          },
          "citation": { "type": "string", "minLength": 1 },
          "summary": {
            "type": "object",
            "required": ["en", "hi", "mr"],
            "properties": {
              "en": { "type": "string", "minLength": 1 },
              "hi": { "type": "string", "minLength": 1 },
              "mr": { "type": "string", "minLength": 1 }
            }
          },
          "sourceUrl": { "type": "string", "pattern": "^https?://" },
          "verified": { "type": "boolean" },
          "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "escalationLadder": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "name", "action", "timeframeHours"],
        "properties": {
          "level": { "type": "integer" },
          "name": {
            "type": "object",
            "required": ["en", "hi", "mr"],
            "properties": {
              "en": { "type": "string", "minLength": 1 },
              "hi": { "type": "string", "minLength": 1 },
              "mr": { "type": "string", "minLength": 1 }
            }
          },
          "action": {
            "type": "object",
            "required": ["en", "hi", "mr"],
            "properties": {
              "en": { "type": "string", "minLength": 1 },
              "hi": { "type": "string", "minLength": 1 },
              "mr": { "type": "string", "minLength": 1 }
            }
          },
          "timeframeHours": { "type": "integer" }
        }
      }
    }
  }
}
