{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChannelsConfig",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "category", "description", "verified", "lastVerified"],
    "properties": {
      "id": { "type": "string" },
      "name": {
        "type": "object",
        "required": ["en", "hi", "mr"],
        "properties": {
          "en": { "type": "string", "minLength": 1 },
          "hi": { "type": "string", "minLength": 1 },
          "mr": { "type": "string", "minLength": 1 }
        }
      },
      "category": { "type": "string" },
      "number": { "type": ["string", "null"] },
      "url": { "type": ["string", "null"] },
      "description": {
        "type": "object",
        "required": ["en", "hi", "mr"],
        "properties": {
          "en": { "type": "string", "minLength": 1 },
          "hi": { "type": "string", "minLength": 1 },
          "mr": { "type": "string", "minLength": 1 }
        }
      },
      "verified": { "type": "boolean" },
      "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
    }
  }
}
